  "keywords": [
    "saints"
  ],
  "author": "Evan C Lewis",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "express-validator": "^6.12.1",
    "fs": "0.0.1-security",
    "helmet": "^6.0.1",
    "https": "^1.0.0",
    "mithril": "^2.0.4",
    "mustache-express": "^1.3.2",
    "node-fetch": "^3.3.1",
    "node-gzip": "^1.1.2",
    "sitemap": "^7.1.1"
  },
  "devDependencies": {
    "compression-webpack-plugin": "^10.0.0",
    "eslint": "^8.15.0",
    "npm-watch": "^0.11.0",
    "webpack": "^5.50.0",
    "webpack-cli": "^5.0.1"
  },
  "watch": {
    "build": {
      "patterns": [
        "src"
      ],
