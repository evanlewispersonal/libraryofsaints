  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server/server.js",
    "debug": "",
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development",
    "watch": "npm-watch",
    "style": "tar -cvzf server/public/styles/styles.css server/public/styles/style.css.gz",
    "stats": "webpack --json > stats.json --mode=production"
